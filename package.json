{
	"name": "pi-todos",
	"version": "1.0.0",
	"description": "File-backed todo tool for the pi coding agent \u2014 durable Markdown todo files with pid-locking, garbage collection, compaction re-injection, and single-flight auto-promotion.",
	"keywords": [
		"pi-package",
		"todo",
		"todos",
		"task-tracking"
	],
	"license": "Apache-2.0",
	"type": "module",
	"main": "todos.ts",
	"files": [
		"todos.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/cabi/pi-todos.git"
	},
	"homepage": "https://github.com/cabi/pi-todos",
	"bugs": {
		"url": "https://github.com/cabi/pi-todos/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"test": "node test/todos.test.mjs"
	},
	"pi": {
		"extensions": [
			"./todos.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"author": "cabi",
	"contributors": "Armin Ronacher \u2014 original todos extension (https://github.com/mitsuhiko/agent-stuff)"
}
